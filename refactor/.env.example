CONTROL_PUBLIC_URL=https://m.buonme.com
CONTROL_DATA_DIR=./runtime
CONTROL_DATABASE_PATH=./runtime/control.db
CONTROL_ADB_PATH=adb
CONTROL_COMMAND_TIMEOUT_SECONDS=15
CONTROL_ALLOW_DEMO_DEVICE=false
CONTROL_ADMIN_USERNAME=admin
CONTROL_ADMIN_PASSWORD_FILE=./runtime/admin-password
CONTROL_SESSION_SECRET_FILE=./runtime/session-secret
CONTROL_COOKIE_SECURE=true

# Optional. Do not copy values into source control.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CLOUDFLARE_TUNNEL_TOKEN=
