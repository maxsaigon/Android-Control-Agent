# OpenAI API Key for GPT-4o
OPENAI_API_KEY=sk-...

# ADB binary path
ADB_PATH=adb

# Optional ADB live control: first run npm ci, npm run setup, npm run build
# inside gateway/scrcpy. ADB server must be running with the device connected.
SCRCPY_ENABLED=false
SCRCPY_NODE_PATH=node
SCRCPY_ADB_HOST=127.0.0.1
SCRCPY_ADB_PORT=5037
SCRCPY_SESSION_SECONDS=1800

# Database
DATABASE_URL=sqlite:///./data/android_control.db

# Server
HOST=0.0.0.0
PORT=8000

# LiveKit screen streaming
# Local docker-compose.livekit.yml defaults:
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_TOKEN_TTL_SECONDS=600

# Owner account for Android Helper pairing without entering username/password.
HELPER_OWNER_USERNAME=admin
